{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "loom-ui-smoke findings",
  "type": "object",
  "required": ["schema_version", "smoke_id", "scope", "stats", "findings"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "smoke_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-.+$",
      "description": "Unique smoke run ID: <YYYY-MM-DD>-<scope>"
    },
    "scope": {
      "type": "string",
      "description": "Smoke scope: 'full', 'smoke-only', or 'route:<name>'",
      "pattern": "^(full|smoke-only|route:.+)$"
    },
    "started_at": {
      "type": "integer",
      "description": "Unix epoch milliseconds when smoke run started",
      "minimum": 0
    },
    "completed_at": {
      "type": "integer",
      "description": "Unix epoch milliseconds when smoke run completed",
      "minimum": 0
    },
    "stats": {
      "type": "object",
      "required": [
        "routes_tested",
        "routes_passed",
        "routes_failed",
        "console_errors",
        "console_warnings"
      ],
      "properties": {
        "routes_tested": {
          "type": "integer",
          "minimum": 0
        },
        "routes_passed": {
          "type": "integer",
          "minimum": 0
        },
        "routes_failed": {
          "type": "integer",
          "minimum": 0
        },
        "console_errors": {
          "type": "integer",
          "minimum": 0
        },
        "console_warnings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "route", "severity", "category", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d{3}$",
            "description": "Finding ID in format F-NNN"
          },
          "route": {
            "type": "string",
            "description": "Route path where finding was detected (e.g. '/room')"
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low", "info"],
            "description": "Finding severity level"
          },
          "category": {
            "type": "string",
            "enum": [
              "rendering",
              "data-flow",
              "navigation",
              "theme",
              "interactivity",
              "console-error",
              "screenshot-mismatch"
            ],
            "description": "Finding category"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Human-readable description of the finding"
          },
          "screenshot_ref": {
            "type": "string",
            "description": "Relative path to screenshot file (e.g. 'screenshots/02-room.png')"
          },
          "expected": {
            "type": "string",
            "description": "Expected state or value"
          },
          "actual": {
            "type": "string",
            "description": "Actual observed state or value"
          },
          "req_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-\\d{3}$"
            },
            "description": "Related acceptance requirement IDs"
          },
          "recommended_action": {
            "type": "string",
            "description": "Recommended remediation action"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
