{
  "$schema": "https://claude-loom.dev/schemas/project-prefs-v1.json",
  "schema_version": 1,

  "lenses": {},

  "auto_apply": {
    "categories": [],
    "max_risk": "never"
  },

  "last_retro": {
    "id": "",
    "milestone": "",
    "completed_at": 0
  },

  "learned_patterns": {
    "common_blockers": [],
    "frequent_finding_categories": []
  },

  "agents": {
    "_comment": "PJ 単位の override (persistent role agents のみ)。user-prefs より優先される。詳細: SPEC §6.9.4。reviewer / retro lens は `skills.*` section を使う (SPEC §3.9 / §4.2.3 / §4.2.5)",
    "loom-developer": {
      "model": "sonnet",
      "personality": "default",
      "learned_guidance": [
        {
          "_comment": "M0.11 から有効、M0.11.1 から auto-prune (ttl_sessions main + last_used_in audit hybrid)。完全な field set は SPEC §6.9.4 + §6.9.4.5 参照",
          "id": "guidance-example-001",
          "added_at": "2026-04-29",
          "from_retro": "m0.x-complete",
          "from_finding_id": "process-tdd-violation-example",
          "category": "process-tdd-violation",
          "guidance": "TDD red commit 時は failing test の output を必ず capture して context に残せ",
          "active": false,
          "ttl_sessions": null,
          "use_count": 0,
          "last_used_in": null
        }
      ]
    }
  },

  "skills": {
    "_comment": "skill-keyed customization (PJ 単位の override)。reviewer / retro lens / counter-arguer / aggregator の skill template を PJ 固有 policy で上書き。user-prefs.skills.* より優先 (SPEC §3.6.5 precedence rule)",
    "loom-review": {
      "strategies": {
        "single": {
          "learned_guidance": []
        },
        "trio": {
          "code": { "learned_guidance": [] },
          "security": { "learned_guidance": [] },
          "test": { "learned_guidance": [] }
        }
      }
    },
    "loom-retro": {
      "lenses": {
        "pj-axis": { "learned_guidance": [] },
        "process-axis": { "learned_guidance": [] },
        "meta-axis": { "learned_guidance": [] },
        "researcher": { "learned_guidance": [] }
      },
      "stages": {
        "counter-arguer": { "learned_guidance": [] },
        "aggregator": { "learned_guidance": [] }
      }
    }
  },

  "worktree": {
    "_comment": "M0.10 から有効。base_path placeholder {branch} は branch slug に置換、auto_cleanup は v1 では false 固定、max_concurrent は自律発動の暴走防止上限",
    "base_path": "<parent>/<repo>-{branch}",
    "auto_cleanup": false,
    "max_concurrent": 5
  },

  "ui": {
    "_comment": "M0.11.5 から有効。auto_launch: false で PJ 単位の lazy daemon auto-launch 無効化 (SPEC §3.2 永続 opt-out)。precedence: project-prefs > user-prefs > default true",
    "auto_launch": true
  }
}
